{
  "name": "obsidian-project-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin for Project Docs: marks private notes, changes sync rules, shows sync status and decodes PRIVATE.md placeholders.",
  "license": "MIT",
  "author": "Corey Struzan",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc --noEmit -p test/e2e && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "@specdevship/project-docs-core": "0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "happy-dom": "^21.0.4",
    "mocha": "^10.8.2",
    "obsidian": "^1.14.4",
    "obsidian-launcher": "^3.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wdio-obsidian-reporter": "^3.3.0",
    "wdio-obsidian-service": "^3.3.0",
    "webdriverio": "^9.32.0"
  }
}
